<?xml version="1.0" encoding="UTF-8"?>
    <!-- 
         ========================================================
         Módulo: LMSGI - CFGS DAM/DAW
         Autor: Sergio García de Baya
         Descripción: Esquema XSD con restricciones RegEx para validar catalogo.xml
         ========================================================
    -->

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    
    <!-- ========================================== -->
    <!-- DEFINICIÓN DE TIPOS SIMPLES (CON REGEX)    -->
    <!-- ========================================== -->
    
    <xs:attributeGroup name="datosGestion">
        <xs:attribute name="id" type="TipoIdServidor" use="required" />
        <xs:attribute name="estado" type="TipoEstado" use="required" />
        <xs:attribute name="ubicacion" type="xs:string" use="required" />
    </xs:attributeGroup>
    
    <xs:group name="especificacionesTecnicas">
        <xs:sequence>
            <xs:element name="cpu" type="TipoCPU" />
            <xs:element name="ram" type="TipoRAM" />
            <xs:element name="almacenamiento" type="TipoDisco" minOccurs="0" maxOccurs="4" />
        </xs:sequence>
    </xs:group>
    
    <!-- Validamos que el ID del servidor siga el patrón: srv-letras-numeros -->
    <xs:simpleType name="TipoIdServidor">
        <xs:restriction base="xs:string">
            <!-- RegEx: Empieza por srv-, seguido de letras minúsculas, guion, y exactamente 2
                 dígitos -->
            <xs:pattern value="srv-[a-z]+-[0-9]{2}" />
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="TipoEstado">
        <xs:restriction base="xs:string">
            <xs:pattern value="activo|mantenimiento|apagado" />
        </xs:restriction>
    </xs:simpleType>
    
    <xs:complexType name="TipoCPU">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="nucleos" type="xs:integer" use="required" />
                <xs:attribute name="arquitectura" type="xs:string" use="required" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    
    <xs:complexType name="TipoRAM">
        <xs:simpleContent>
            <xs:extension base="xs:integer">
                <xs:attribute name="unidad" use="required">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="MB|GB|TB" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    
    <xs:complexType name="TipoDisco">
        <xs:attribute name="tipo" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:pattern value="NVMe|SSD|HDD" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="capacidad_tb" type="xs:integer" use="required" />
        <xs:attributeGroup ref="datosGestion" /> </xs:complexType>
    
    <!-- ========================================== -->
    <!-- ESTRUCTURA DEL DOCUMENTO (ELEMENTOS)       -->
    <!-- ========================================== -->
    
    <xs:element name="catalogo_cloud">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="servidor" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:choice>
                                <xs:element name="mac_address" type="xs:string" />
                                <xs:element name="id_interno" type="xs:string" />
                            </xs:choice>
                            
                            <xs:group ref="especificacionesTecnicas" />
                            
                            <xs:element name="notas_mantenimiento" minOccurs="0">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="fecha" type="xs:date" />
                                        <xs:element name="autor" type="xs:string" />
                                        <xs:element name="comentario" type="xs:string" />
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        
                        <xs:attributeGroup ref="datosGestion" />
                        <xs:attribute name="rack" type="xs:string" use="required" />
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
        
        <xs:unique name="unicoServidorId">
            <xs:selector xpath="servidor" />
            <xs:field xpath="@id" />
        </xs:unique>
    </xs:element>
    
</xs:schema>